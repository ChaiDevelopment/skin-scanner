<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY: allows http:// to the local development backend (emulator 10.0.2.2 or a LAN IP).
     Release builds use src/main/res/xml/network_security_config.xml (HTTPS only). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
