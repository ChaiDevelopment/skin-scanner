{
  "name": "ai-skin-scanner-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AI Skin Scanner API — Express + TypeScript + Gemini + Firebase Admin",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:gemini": "tsx scripts/gemini-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
