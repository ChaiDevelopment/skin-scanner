# Copy to backend/.env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_MS=90000

# Firebase Admin (service account — see docs/FIREBASE_SETUP.md)
# Option A: the three fields below. FIREBASE_PRIVATE_KEY keeps literal \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option B: path to a service-account JSON file (kept outside git)
GOOGLE_APPLICATION_CREDENTIALS=
# Storage bucket, e.g. your-project.firebasestorage.app (needed only for optional photo storage)
FIREBASE_STORAGE_BUCKET=

# Comma-separated list of allowed browser origins. Android apps do not send Origin; leave empty to block browsers.
CORS_ORIGIN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

MAX_IMAGE_SIZE_MB=10

# Set to true behind a reverse proxy / load balancer (needed for correct client IPs)
TRUST_PROXY=false

# DEVELOPMENT ONLY. Lets the debug Android app call the API without Firebase,
# using the token "dev-local-token" and an in-memory history store.
# Refused when NODE_ENV=production.
DEV_AUTH_BYPASS=false

# Firebase App Check for the X-Firebase-AppCheck header: off | monitor | enforce
# Start with "monitor", switch to "enforce" once all clients send valid tokens.
APP_CHECK_MODE=off
